---
import { EMAIL, GITHUB_URL, SITE_NAME } from '../../lib/site';
import EmailIcon from './EmailIcon.astro';
import GitHubIcon from './GitHubIcon.astro';
import RssIcon from './RssIcon.astro';
import SearchIcon from './SearchIcon.astro';
---

<header class="site-header">
  <div class="header-inner">
    <a class="site-brand" href="/" aria-label={`${SITE_NAME} home`}>
      {SITE_NAME}
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      <a href="/">Home</a>
      <a href="/blog/">Blog</a>
      <a href="/about/">About</a>
    </nav>

    <div class="nav-tools">
      <button
        class="icon-button search-trigger"
        type="button"
        id="search-open"
        aria-label="Open search"
      >
        <SearchIcon />
      </button>

      <a
        class="icon-button"
        href={GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GetFOSS on GitHub"
      >
        <GitHubIcon />
      </a>

      <a
        class="icon-button"
        href={`mailto:${EMAIL}`}
        aria-label={`Email ${EMAIL}`}
      >
        <EmailIcon />
      </a>

      <a class="icon-button" href="/rss.xml" aria-label="RSS feed">
        <RssIcon />
      </a>

      <div class="social-links" aria-label="Social media">
        <a
          class="nav-social-link"
          href="https://bsky.app/profile/getfoss.org"
          target="_blank"
          rel="noopener noreferrer"
        >
          Bluesky
        </a>

        <a
          class="nav-social-link"
          href="https://www.facebook.com/getfossorg"
          target="_blank"
          rel="noopener noreferrer"
        >
          Facebook
        </a>

        <a
          class="nav-social-link"
          href="https://x.com/getfoss_org"
          target="_blank"
          rel="noopener noreferrer"
        >
          X
        </a>
      </div>
    </div>

    <details class="mobile-menu">
      <summary aria-label="Open navigation menu">
        <span></span>
        <span></span>
        <span></span>
      </summary>

      <nav class="mobile-nav" aria-label="Mobile navigation">
        <a href="/">Home</a>
        <a href="/blog/">Blog</a>
        <a href="/about/">About</a>
        <a href="/rss.xml">RSS</a>
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={`mailto:${EMAIL}`}>Email</a>
        <a href="https://bsky.app/profile/getfoss.org" target="_blank" rel="noopener noreferrer">Bluesky</a>
        <a href="https://www.facebook.com/getfossorg" target="_blank" rel="noopener noreferrer">Facebook</a>
        <a href="https://x.com/getfoss_org" target="_blank" rel="noopener noreferrer">X</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    border-bottom: 1px solid var(--border);
    background: var(--background);
  }

  .header-inner {
    width: min(100% - 3rem, var(--content-width, 1200px));
    min-height: 4.5rem;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .site-brand {
    color: var(--foreground);
    font-family: var(--mono);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.06em;
    text-decoration: none;
    white-space: nowrap;
  }

  .desktop-nav,
  .nav-tools,
  .social-links {
    display: flex;
    align-items: center;
  }

  .desktop-nav {
    gap: 1.5rem;
    margin-left: auto;
  }

  .desktop-nav a,
  .nav-social-link {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.75rem;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .desktop-nav a:hover,
  .nav-social-link:hover {
    color: var(--foreground);
  }

  .nav-tools {
    gap: 0.85rem;
  }

  .icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    text-decoration: none;
    transition: color 160ms ease, transform 160ms ease;
  }

  .icon-button:hover {
    color: var(--foreground);
    transform: translateY(-2px);
  }

  .icon-button :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .social-links {
    gap: 0.8rem;
    padding-left: 0.5rem;
    border-left: 1px solid var(--border);
  }

  .nav-social-link {
    white-space: nowrap;
  }

  .mobile-menu {
    display: none;
    position: relative;
  }

  .mobile-menu summary {
    display: flex;
    width: 2.5rem;
    height: 2.5rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    cursor: pointer;
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu summary span {
    display: block;
    width: 1.25rem;
    height: 2px;
    border-radius: 2px;
    background: var(--foreground);
    transition: transform 160ms ease;
  }

  .mobile-menu[open] summary span:first-child {
    transform: translateY(7px) rotate(45deg);
  }

  .mobile-menu[open] summary span:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu[open] summary span:last-child {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-nav {
    position: absolute;
    top: calc(100% + 0.75rem);
    right: 0;
    display: flex;
    min-width: 13rem;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius, 0.75rem);
    background: var(--background);
    box-shadow: 0 12px 32px rgb(0 0 0 / 12%);
  }

  .mobile-nav a {
    padding: 0.65rem 0.75rem;
    border-radius: 0.35rem;
    color: var(--foreground);
    font-family: var(--mono);
    font-size: 0.8rem;
    text-decoration: none;
  }

  .mobile-nav a:hover {
    background: var(--surface);
  }

  @media (max-width: 900px) {
    .header-inner {
      width: min(100% - 2rem, var(--content-width, 1200px));
    }

    .desktop-nav {
      gap: 1rem;
    }

    .nav-tools {
      gap: 0.55rem;
    }

    .social-links {
      gap: 0.55rem;
    }
  }

  @media (max-width: 720px) {
    .header-inner {
      min-height: 4rem;
    }

    .desktop-nav,
    .nav-tools {
      display: none;
    }

    .mobile-menu {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .icon-button,
    .desktop-nav a,
    .nav-social-link,
    .mobile-menu summary span {
      transition: none;
    }
  }
</style>
