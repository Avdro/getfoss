
---
import type { CollectionEntry } from 'astro:content';
import { formatPostDate, postSlug } from '../lib/posts';
import { slugifyTag } from '../lib/tags';

interface Props {
  post: CollectionEntry<'blog'>;
  latest?: boolean;
}

const { post, latest = false } = Astro.props;
const tags = post.data.tags.filter((tag) => slugifyTag(tag) !== '');
---

<article class="post-card">
  <a class="post-card-link" href={`/blog/${postSlug(post)}/`}>
    <div>
      <h2>
        {post.data.title}
        {latest && <span class="tag-latest">latest</span>}
      </h2>

      <p>{post.data.description}</p>

      <p class="post-card-meta">
        <span class="post-card-category">{post.data.category}</span>
        <span class="post-card-meta-separator" aria-hidden="true">·</span>
        <time datetime={post.data.date.toISOString()}>
          {formatPostDate(post.data.date)}
        </time>
      </p>
    </div>
  </a>

  {tags.length > 0 && (
    <p class="post-tags">
      {tags.map((tag) => (
        <a class="tag" href={`/tags/${slugifyTag(tag)}/`}>#{tag}</a>
      ))}
    </p>
  )}
</article>

<style is:global>
  .post-card + .post-card {
    border-top: 1px solid var(--line);
  }

  .tag-latest {
    display: inline-block;
    margin-left: 0.7rem;
    padding: 0.12rem 0.6rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    vertical-align: middle;
    transform: translateY(-0.15em);
  }

  .post-card-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.45rem 0;
    text-decoration: none;
  }

  .post-card h2 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.45rem, 3vw, 2.05rem);
    font-family: var(--mono);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.055em;
    transition: color 0.16s ease;
  }

  .post-card p {
    max-width: 680px;
    margin: 0.55rem 0 0;
    color: color-mix(in srgb, var(--ink) 62%, var(--muted));
    line-height: 1.55;
  }

  .post-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0.65rem 0 0;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .post-card .post-card-meta-separator {
    margin: 0;
    color: var(--muted);
  }

  .post-card-category {
    color: var(--accent);
  }

  .post-card:hover h2 {
    color: var(--accent);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .post-card .post-tags {
    margin: -0.85rem 0 0;
    padding: 0 0 1.45rem;
  }
</style>
