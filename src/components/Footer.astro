---
import { SITE_NAME } from '../lib/site';
---

<footer class="footer">
  <span class="copyright">
    &copy; {new Date().getFullYear()} {SITE_NAME}
  </span>

  <nav class="social-links" aria-label="GetFOSS social media">
    <a
      href="https://bsky.app/profile/getfoss.org"
      target="_blank"
      rel="noopener noreferrer"
    >
      Bluesky
    </a>
    <a
      href="https://www.facebook.com/getfossorg"
      target="_blank"
      rel="noopener noreferrer"
    >
      Facebook
    </a>
    <a
      href="https://x.com/getfoss_org"
      target="_blank"
      rel="noopener noreferrer"
    >
      X
    </a>
  </nav>
</footer>

<style is:global>
  .footer {
    padding: 1.75rem 1.25rem;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    color: var(--muted);
    font-size: 0.85rem;
    font-family: var(--mono);
  }

  .social-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .social-links a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .social-links a:hover {
    color: var(--text);
  }
</style>
