---
interface Props {
  name: string;
  slug: string;
  description: string;
  category: string;
  version: string;
  releaseDate: string;
  platforms: string[];
  license: string;
  icon?: string;
}

const {
  name,
  slug,
  description,
  category,
  version,
  releaseDate,
  platforms,
  license,
  icon,
} = Astro.props;

const formattedDate = new Date(`${releaseDate}T00:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<a class="release-card" href={`/releases/${slug}/`} aria-label={`View ${name} release history`}>
  <div class="card-top">
    <div class="app-identity">
      {icon ? (
        <img class="app-icon" src={icon} alt="" loading="lazy" />
      ) : (
        <span class="app-icon app-icon-fallback" aria-hidden="true">
          {name.slice(0, 1).toUpperCase()}
        </span>
      )}
      <div class="app-heading">
        <h2>{name}</h2>
        <span class="category">{category}</span>
      </div>
    </div>
    <span class="version-badge">v{version}</span>
  </div>

  <p class="description">{description}</p>

  <div class="release-info">
    <div class="info-item">
      <span class="info-label">Latest Stable Version</span>
      <strong>{version}</strong>
    </div>
    <div class="info-item">
      <span class="info-label">Released</span>
      <strong>{formattedDate}</strong>
    </div>
  </div>

  <div class="card-bottom">
    <div class="platforms" aria-label="Supported platforms">
      {platforms.map((platform) => (
        <span class="platform">{platform}</span>
      ))}
    </div>
    <span class="license">{license}</span>
  </div>

  <span class="card-arrow" aria-hidden="true">↗</span>
</a>

<style>
  .release-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    padding: 1.25rem;
    gap: 1.15rem;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 12px;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .release-card:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgb(0 0 0 / 6%);
  }

  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .app-identity {
    display: flex;
    align-items: center;
    min-width: 0;
    gap: 0.85rem;
  }

  .app-icon {
    display: block;
    flex: 0 0 48px;
    width: 48px;
    height: 48px;
    object-fit: contain;
    border-radius: 10px;
  }

  .app-icon-fallback {
    display: grid;
    place-items: center;
    color: var(--accent);
    background: var(--line);
    font-family: var(--mono);
    font-size: 1.35rem;
    font-weight: 800;
  }

  .app-heading {
    min-width: 0;
  }

  .app-heading h2 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 750;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .category {
    display: inline-block;
    margin-top: 0.3rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.7rem;
    line-height: 1.4;
  }

  .version-badge {
    flex: 0 0 auto;
    padding: 0.35rem 0.55rem;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, var(--bg));
    border: 1px solid color-mix(in srgb, var(--accent) 25%, var(--line));
    border-radius: 6px;
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 750;
    white-space: nowrap;
  }

  .description {
    display: -webkit-box;
    min-height: 3.9em;
    margin: 0;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.55;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .release-info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    padding: 0.85rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .info-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .info-label {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.65rem;
    line-height: 1.4;
  }

  .info-item strong {
    font-size: 0.85rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .card-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    margin-top: auto;
    padding-right: 1.25rem;
  }

  .platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .platform {
    padding: 0.2rem 0.4rem;
    color: var(--muted);
    background: var(--line);
    border-radius: 4px;
    font-family: var(--mono);
    font-size: 0.65rem;
  }

  .license {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.68rem;
  }

  .card-arrow {
    position: absolute;
    right: 1.15rem;
    bottom: 1.15rem;
    color: var(--muted);
    font-size: 0.9rem;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .release-card:hover .card-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  @media (max-width: 480px) {
    .release-card {
      padding: 1rem;
    }

    .app-icon {
      flex-basis: 40px;
      width: 40px;
      height: 40px;
    }

    .card-top {
      gap: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .release-card,
    .card-arrow {
      transition: none;
    }

    .release-card:hover {
      transform: none;
    }
  }
</style>
