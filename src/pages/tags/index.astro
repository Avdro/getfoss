---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import TypedLede from '../../components/TypedLede.astro';
import { getAllTags } from '../../lib/tags';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft);

const tags = getAllTags(posts);
---

<Layout
  title="Tags — GetFOSS"
  description="Free and open-source software, done right. GetFOSS picks the best FOSS apps — private, secure, and community-driven — for every platform. Explore articles by tag."
  canonicalPath="/tags/"
>
  <main class="content-shell">
    <section class="page-hero">
      <h1 class="visually-hidden">Tags</h1>
      <TypedLede text="Explore free and open-source software by topic." />
    </section>

    <section class="section" aria-label="Tags">
      {tags.length === 0 ? (
        <p style="color: var(--muted); font-family: var(--mono);">
          No tags available yet. Check back soon.
        </p>
      ) : (
        <div class="tag-cloud">
          {tags.map(({ slug, name, count }) => (
            <a class="tag" href={`/tags/${slug}/`}>
              #{name}
              {count > 0 && <span class="tag-count">{count}</span>}
            </a>
          ))}
        </div>
      )}
    </section>
  </main>
</Layout>

<style is:global>
  .tag-count {
    color: var(--muted-2);
    font-weight: 400;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .tag-cloud .tag {
    font-size: 0.78rem;
    padding: 0.22rem 0.75rem;
  }
</style>
