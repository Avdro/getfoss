
---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import TypedLede from '../../components/TypedLede.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
  title="Blog — GetFOSS"
  description="Explore articles about free and open-source software, Linux, privacy, security, development tools, and the open-source ecosystem."
  canonicalPath="/blog/"
>
  <main class="content-shell">
    <section class="page-hero">
      <h1 class="visually-hidden">GetFOSS Blog</h1>
      <TypedLede text="Discover free and open-source software." />
    </section>

    <section class="section" aria-label="Blog posts">
      {posts.length === 0 ? (
        <p style="color: var(--muted); font-family: var(--mono);">
          No articles published yet. Check back soon.
        </p>
      ) : (
        <div class="post-list">
          {posts.map((post, index) => (
            <PostCard post={post} latest={index === 0} />
          ))}
        </div>
      )}
    </section>
  </main>
</Layout>
