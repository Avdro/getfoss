---
import { getCollection } from 'astro:content';
import Layout from '../components/Layout.astro';
import TypedLede from '../components/TypedLede.astro';
import { formatPostDate, postSlug } from '../lib/posts';
import { SITE_URL } from '../lib/site';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const siteDescription =
  'Free and open-source software, done right. GetFOSS picks the best FOSS apps — private, secure, and community-driven — for every platform.';

const organizationSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'GetFOSS',
  url: SITE_URL,
  description: siteDescription,
}).replace(/</g, '\\u003c');
---

<Layout
  title="GetFOSS — Free and Open-Source Software"
  description={siteDescription}
  canonicalPath="/"
>
  <script type="application/ld+json" is:inline set:html={organizationSchema} />

  <main class="content-shell">
    <section class="page-hero">
      <h1 class="visually-hidden">GetFOSS</h1>
      <TypedLede text={siteDescription} />
    </section>

    <section class="section" aria-label="Recent articles">
      <nav class="commit-tree" aria-label="Site navigation">
        <a class="commit-tree-head" href="/blog/" title="All articles">
          Latest articles
        </a>

        {posts.length === 0 ? (
          <p class="empty-note">No articles published yet. Check back soon.</p>
        ) : (
          posts.map((post) => (
            <a href={`/blog/${postSlug(post)}/`}>
              {post.data.title}
              <span class="commit-tree-date">
                {formatPostDate(post.data.date)}
              </span>
            </a>
          ))
        )}

        <a href="/blog/">All articles</a>
        <a href="/tags/">Browse tags</a>
        <a href="/about/">About GetFOSS</a>
      </nav>
    </section>
  </main>
</Layout>

<style is:global>
  .commit-tree {
    display: grid;
    gap: 1.15rem;
    margin-left: 5px;
    border-left: 2px solid var(--line);
    font-family: var(--mono);
  }

  .commit-tree a {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 1rem;
    padding-left: 1.25rem;
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.45;
    text-decoration: none;
  }

  .commit-tree a::before {
    content: "";
    position: absolute;
    left: -6px;
    top: 0.28em;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid var(--line-strong);
    background: var(--bg);
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .commit-tree a:hover {
    color: var(--accent);
  }

  .commit-tree a:hover::before {
    border-color: var(--accent);
  }

  .commit-tree .commit-tree-head {
    color: var(--accent);
    font-size: 0.95rem;
  }

  .commit-tree .commit-tree-head::before {
    left: -7px;
    top: 0.24em;
    width: 12px;
    height: 12px;
    border-color: var(--accent);
    background: var(--accent);
  }

  .commit-tree .commit-tree-head:hover {
    text-decoration: underline;
  }

  .commit-tree-date {
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .empty-note {
    margin: 0;
    padding-left: 1.25rem;
    color: var(--muted);
    font-family: var(--mono);
  }
</style>
