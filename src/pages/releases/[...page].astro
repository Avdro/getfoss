---
/**
 * GetFOSS — Stable Releases Catalog
 * File: src/pages/releases/[...page].astro
 *
 * Static pagination: 20 pages × 15 cards = 300 applications.
 * URLs: /releases/ (page 1), /releases/2/ (page 2), … /releases/20/ (page 20).
 *
 * Client-side search & filtering by name, description, category, platform, license.
 * All 300 ReleaseCard components are rendered at build time; JavaScript only
 * shows/hides them based on the active filters. This preserves the Palette
 * card design and avoids duplicating card markup in JS.
 *
 * NOTE: ReleaseCard accepts individual props (name, slug, description, category,
 * version, releaseDate, platforms, license, icon?). The `releaseDate` prop
 * expects a YYYY-MM-DD string (the component appends "T00:00:00Z" internally),
 * so we split the ISO timestamp from releases.json on "T" to get the date part.
 * The `version` prop expects the latest stable version string. Both fall back
 * to empty strings when releases.json has no data yet (first run).
 */

import Layout from '../../components/Layout.astro';
import ReleaseCard from '../../components/releases/ReleaseCard.astro';
import softwareData from '../../data/releases/software.json';
import releasesData from '../../data/releases/releases.json';

const APPS_PER_PAGE = 15;

// Merge catalog metadata with release data.
function buildAppData(app) {
  const releaseData = releasesData.applications[app.id];
  const latestRelease =
    releaseData && Array.isArray(releaseData.releases) && releaseData.releases.length > 0
      ? releaseData.releases[0]
      : null;
  return {
    ...app,
    latestVersion: latestRelease ? latestRelease.version : null,
    latestReleaseDate: latestRelease ? latestRelease.releaseDate : null,
    latestReleaseUrl: latestRelease ? latestRelease.releaseUrl : null,
  };
}

const allApps = softwareData.applications.map(buildAppData);
const TOTAL_APPS = allApps.length;
const TOTAL_PAGES = Math.ceil(TOTAL_APPS / APPS_PER_PAGE);

// Unique filter values
const categories = [...new Set(allApps.map((a) => a.category))].sort();
const platforms = [...new Set(allApps.flatMap((a) => a.platforms))].sort();
const licenses = [...new Set(allApps.map((a) => a.license))].sort();

export function getStaticPaths() {
  const paths = [{ params: { page: undefined } }]; // /releases/
  for (let i = 2; i <= TOTAL_PAGES; i++) {
    paths.push({ params: { page: String(i) } });
  }
  return paths;
}

const { page } = Astro.params;
const pageStr = Array.isArray(page) ? page[0] : page;
const currentPage = pageStr ? parseInt(pageStr, 10) : 1;
const startIdx = (currentPage - 1) * APPS_PER_PAGE;
const endIdx = startIdx + APPS_PER_PAGE;

const pageTitle = currentPage === 1
  ? 'Stable Releases — GetFOSS'
  : `Stable Releases — Page ${currentPage} — GetFOSS`;
const pageDescription = `Browse ${TOTAL_APPS} verified free and open-source applications with their latest stable release information. Page ${currentPage} of ${TOTAL_PAGES}.`;
---

<Layout title={pageTitle} description={pageDescription}>
  <section class="releases-catalog">
    <header class="releases-catalog__header">
      <h1>Stable Releases</h1>
      <p class="releases-catalog__subtitle">
        Browse {TOTAL_APPS} verified FOSS applications with their latest stable release information.
      </p>
    </header>

    <!-- Search & Filters -->
    <div class="releases-catalog__controls">
      <div class="releases-catalog__search-row">
        <input
          type="search"
          id="releases-search"
          class="releases-catalog__search-input"
          placeholder="Search by name, description, category, platform, or license…"
          autocomplete="off"
          aria-label="Search applications"
        />
      </div>
      <div class="releases-catalog__filter-row">
        <select id="releases-filter-category" aria-label="Filter by category" class="releases-catalog__select">
          <option value="">All Categories</option>
          {categories.map((cat) => <option value={cat}>{cat}</option>)}
        </select>
        <select id="releases-filter-platform" aria-label="Filter by platform" class="releases-catalog__select">
          <option value="">All Platforms</option>
          {platforms.map((p) => <option value={p}>{p}</option>)}
        </select>
        <select id="releases-filter-license" aria-label="Filter by license" class="releases-catalog__select">
          <option value="">All Licenses</option>
          {licenses.map((l) => <option value={l}>{l}</option>)}
        </select>
        <button type="button" id="releases-clear" class="releases-catalog__clear-btn">
          Clear
        </button>
      </div>
    </div>

    <!-- Results info (shown when filtering) -->
    <p id="releases-results-info" class="releases-catalog__results-info" role="status" aria-live="polite"></p>

    <!-- No-results message (hidden by default) -->
    <p id="releases-no-results" class="releases-catalog__no-results" style="display: none;">
      No applications match your search. Try adjusting your filters.
    </p>

    <!-- Cards grid: all 300 cards rendered; current page's 15 are visible by default -->
    <div class="releases-catalog__grid" id="releases-grid">
      {allApps.map((app, idx) => (
        <div
          class:list={["release-card-wrapper", { "release-card-wrapper--visible": idx >= startIdx && idx < endIdx }]}
          data-name={app.name}
          data-description={app.description}
          data-category={app.category}
          data-platforms={app.platforms.join(',')}
          data-license={app.license}
        >
          <ReleaseCard
            name={app.name}
            slug={app.slug}
            description={app.description}
            category={app.category}
            version={app.latestVersion || ''}
            releaseDate={app.latestReleaseDate ? app.latestReleaseDate.split('T')[0] : ''}
            platforms={app.platforms}
            license={app.license}
          />
        </div>
      ))}
    </div>

    <!-- Pagination -->
    <nav class="releases-catalog__pagination" id="releases-pagination" aria-label="Catalog pages">
      {currentPage > 1 && (
        <a
          href={currentPage === 2 ? '/releases/' : `/releases/${currentPage - 1}/`}
          class="releases-catalog__page-nav releases-catalog__page-nav--prev"
          rel="prev"
        >
          ← Previous
        </a>
      )}
      <span class="releases-catalog__page-numbers">
        {Array.from({ length: TOTAL_PAGES }, (_, i) => i + 1).map((p) => (
          <a
            href={p === 1 ? '/releases/' : `/releases/${p}/`}
            class:list={["releases-catalog__page-link", { "releases-catalog__page-link--active": p === currentPage }]}
            aria-current={p === currentPage ? 'page' : undefined}
          >
            {p}
          </a>
        ))}
      </span>
      {currentPage < TOTAL_PAGES && (
        <a
          href={`/releases/${currentPage + 1}/`}
          class="releases-catalog__page-nav releases-catalog__page-nav--next"
          rel="next"
        >
          Next →
        </a>
      )}
    </nav>
  </section>

  <style>
    .releases-catalog {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem 1rem 4rem;
    }

    .releases-catalog__header {
      margin-bottom: 2rem;
    }

    .releases-catalog__header h1 {
      font-size: clamp(1.75rem, 4vw, 2.5rem);
      margin: 0 0 0.5rem;
    }

    .releases-catalog__subtitle {
      color: var(--palette-text-muted, #6b7280);
      font-size: 1.05rem;
      margin: 0;
    }

    .releases-catalog__controls {
      margin-bottom: 1.5rem;
    }

    .releases-catalog__search-row {
      margin-bottom: 0.75rem;
    }

    .releases-catalog__search-input {
      width: 100%;
      padding: 0.75rem 1rem;
      font-size: 1rem;
      border: 1px solid var(--palette-border, #d1d5db);
      border-radius: 6px;
      background: var(--palette-bg, #fff);
      color: inherit;
      transition: border-color 0.15s ease;
    }

    .releases-catalog__search-input:focus {
      outline: none;
      border-color: var(--palette-primary, #2563eb);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }

    .releases-catalog__filter-row {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
      align-items: center;
    }

    .releases-catalog__select {
      padding: 0.5rem 0.75rem;
      font-size: 0.9rem;
      border: 1px solid var(--palette-border, #d1d5db);
      border-radius: 6px;
      background: var(--palette-bg, #fff);
      color: inherit;
      cursor: pointer;
    }

    .releases-catalog__select:focus {
      outline: none;
      border-color: var(--palette-primary, #2563eb);
    }

    .releases-catalog__clear-btn {
      padding: 0.5rem 1rem;
      font-size: 0.9rem;
      border: 1px solid var(--palette-border, #d1d5db);
      border-radius: 6px;
      background: transparent;
      color: inherit;
      cursor: pointer;
      transition: background 0.15s ease;
    }

    .releases-catalog__clear-btn:hover {
      background: var(--palette-bg-hover, #f3f4f6);
    }

    .releases-catalog__results-info {
      margin: 0 0 1rem;
      font-size: 0.9rem;
      color: var(--palette-text-muted, #6b7280);
      min-height: 1.2em;
    }

    .releases-catalog__no-results {
      text-align: center;
      padding: 2rem;
      color: var(--palette-text-muted, #6b7280);
      font-size: 1.1rem;
    }

    .releases-catalog__grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.5rem;
      margin-bottom: 2.5rem;
    }

    /* All card wrappers are hidden by default; visible ones get the --visible class */
    .release-card-wrapper {
      display: none;
    }
    .release-card-wrapper--visible {
      display: block;
    }

    .releases-catalog__pagination {
      display: flex;
      gap: 0.4rem;
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
      margin-top: 2rem;
      padding-top: 2rem;
      border-top: 1px solid var(--palette-border, #e5e7eb);
    }

    .releases-catalog__page-numbers {
      display: flex;
      gap: 0.3rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .releases-catalog__page-link,
    .releases-catalog__page-nav {
      display: inline-flex;
      align-items: center;
      padding: 0.4rem 0.7rem;
      border: 1px solid var(--palette-border, #d1d5db);
      border-radius: 6px;
      text-decoration: none;
      color: inherit;
      font-size: 0.9rem;
      transition: background 0.15s ease, border-color 0.15s ease;
    }

    .releases-catalog__page-link:hover,
    .releases-catalog__page-nav:hover {
      background: var(--palette-bg-hover, #f3f4f6);
    }

    .releases-catalog__page-link--active {
      background: var(--palette-primary, #2563eb);
      color: #fff;
      border-color: var(--palette-primary, #2563eb);
    }
    .releases-catalog__page-link--active:hover {
      background: var(--palette-primary-dark, #1d4ed8);
    }

    /* When search/filter is active, hide pagination */
    .releases-catalog__pagination--hidden {
      display: none;
    }

    @media (max-width: 640px) {
      .releases-catalog__filter-row {
        flex-direction: column;
        align-items: stretch;
      }
      .releases-catalog__select,
      .releases-catalog__clear-btn {
        width: 100%;
      }
    }
  </style>

  <script>
    // Client-side search & filtering.
    // All 300 cards are pre-rendered in the HTML. This script shows/hides
    // cards based on the search query and filter dropdowns. When no filter
    // is active, only the current page's 15 cards are shown (via the
    // --visible CSS class). When filtering, pagination is hidden and all
    // matching cards across all pages are shown.

    const searchInput = document.getElementById('releases-search') as HTMLInputElement;
    const categoryFilter = document.getElementById('releases-filter-category') as HTMLSelectElement;
    const platformFilter = document.getElementById('releases-filter-platform') as HTMLSelectElement;
    const licenseFilter = document.getElementById('releases-filter-license') as HTMLSelectElement;
    const clearBtn = document.getElementById('releases-clear') as HTMLButtonElement;
    const grid = document.getElementById('releases-grid') as HTMLElement;
    const resultsInfo = document.getElementById('releases-results-info') as HTMLParagraphElement;
    const noResults = document.getElementById('releases-no-results') as HTMLParagraphElement;
    const pagination = document.getElementById('releases-pagination') as HTMLElement;

    const allCards = Array.from(
      grid.querySelectorAll<HTMLElement>('.release-card-wrapper')
    );

    function isFilterActive(): boolean {
      return !!(
        searchInput.value.trim() ||
        categoryFilter.value ||
        platformFilter.value ||
        licenseFilter.value
      );
    }

    function performFilter(): void {
      const query = searchInput.value.toLowerCase().trim();
      const category = categoryFilter.value;
      const platform = platformFilter.value;
      const license = licenseFilter.value;

      if (!isFilterActive()) {
        // Restore static view: show only the current page's visible cards
        allCards.forEach((card) => {
          card.style.display = '';
        });
        // Hide cards that don't have the --visible class (other pages)
        allCards.forEach((card) => {
          if (!card.classList.contains('release-card-wrapper--visible')) {
            card.style.display = 'none';
          }
        });
        resultsInfo.textContent = '';
        noResults.style.display = 'none';
        pagination.classList.remove('releases-catalog__pagination--hidden');
        return;
      }

      // Filtering mode: evaluate each card
      let matchCount = 0;
      allCards.forEach((card) => {
        const name = (card.dataset.name || '').toLowerCase();
        const description = (card.dataset.description || '').toLowerCase();
        const cardCategory = card.dataset.category || '';
        const platforms = (card.dataset.platforms || '').split(',');
        const cardLicense = card.dataset.license || '';

        let matches = true;

        if (query) {
          matches =
            name.includes(query) ||
            description.includes(query) ||
            cardCategory.toLowerCase().includes(query) ||
            platforms.some((p) => p.toLowerCase().includes(query)) ||
            cardLicense.toLowerCase().includes(query);
        }

        if (matches && category && cardCategory !== category) matches = false;
        if (matches && platform && !platforms.includes(platform)) matches = false;
        if (matches && license && cardLicense !== license) matches = false;

        card.style.display = matches ? '' : 'none';
        if (matches) matchCount++;
      });

      // Hide pagination during filtering
      pagination.classList.add('releases-catalog__pagination--hidden');
      resultsInfo.textContent =
        matchCount +
        ' result' +
        (matchCount === 1 ? '' : 's') +
        ' found';
      noResults.style.display = matchCount === 0 ? '' : 'none';
    }

    searchInput.addEventListener('input', performFilter);
    categoryFilter.addEventListener('change', performFilter);
    platformFilter.addEventListener('change', performFilter);
    licenseFilter.addEventListener('change', performFilter);
    clearBtn.addEventListener('click', () => {
      searchInput.value = '';
      categoryFilter.value = '';
      platformFilter.value = '';
      licenseFilter.value = '';
      performFilter();
      searchInput.focus();
    });

    // Keyboard shortcut: "/" focuses the search input
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== searchInput) {
        e.preventDefault();
        searchInput.focus();
      }
    });
  </script>
</Layout>
