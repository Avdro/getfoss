---
import Layout from '../../components/Layout.astro';
import softwareData from '../../data/releases/software.json';
import releasesData from '../../data/releases/releases.json';

interface CatalogApp {
  id: string;
  name: string;
  slug: string;
  description: string;
  category: string;
  platforms: string[];
  license: string;
  website?: string;
  sourceUrl?: string;
}

interface ReleaseEntry {
  version: string;
  name?: string;
  releaseDate?: string | null;
  releaseUrl?: string;
  releaseNotes?: string;
}

interface ReleaseApplication {
  name?: string;
  lastFetch?: string | null;
  sourceUrl?: string;
  releases?: ReleaseEntry[];
}

interface ReleasesFile {
  schemaVersion: number;
  lastUpdated?: string | null;
  applications: Record<string, ReleaseApplication>;
}

const catalog = softwareData.applications as CatalogApp[];
const releaseFile = releasesData as ReleasesFile;

export function getStaticPaths() {
  return softwareData.applications.map((app) => ({
    params: { slug: app.slug },
    props: { appId: app.id },
  }));
}

const { appId } = Astro.props;
const app = catalog.find((item) => item.id === appId);

if (!app) {
  throw new Error(`Stable Releases: application not found for id "${appId}"`);
}

const releaseData = releaseFile.applications?.[app.id];
const releases = Array.isArray(releaseData?.releases) ? releaseData.releases : [];

function formatDate(value?: string | null) {
  if (!value) return 'Date unavailable';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return 'Date unavailable';
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
}

const latestRelease = releases[0];

// Use the application's official website favicon as its icon, matching the catalogue cards.
let appIconUrl: string | undefined;
if (app.website) {
  try {
    const websiteUrl = new URL(app.website);
    appIconUrl = `https://www.google.com/s2/favicons?domain=${encodeURIComponent(websiteUrl.hostname)}&sz=128`;
  } catch {
    appIconUrl = undefined;
  }
}

const pageTitle = `${app.name} Stable Release History — GetFOSS`;
const pageDescription = `Stable release history for ${app.name}. Browse versions, release dates, and official release notes.`;
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="release-history">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/releases/">Stable Releases</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{app.name}</span>
    </nav>

    <header class="history-header">
      <a class="back-link" href="/releases/">← Back to Stable Releases</a>
      <div class="app-title-row">
        <div class="app-icon">
          {appIconUrl ? (
            <img src={appIconUrl} alt={`${app.name} icon`} width="64" height="64" loading="eager" referrerpolicy="no-referrer" />
          ) : (
            <span aria-hidden="true">{app.name.slice(0, 1).toUpperCase()}</span>
          )}
        </div>
        <div>
          <p class="eyebrow">{app.category}</p>
          <h1>{app.name}</h1>
        </div>
      </div>
      <p class="app-description">{app.description}</p>
      <div class="app-meta">
        <span>{app.platforms.join(' · ')}</span>
        <span>{app.license}</span>
      </div>
      <div class="app-links">
        {app.website && <a href={app.website} target="_blank" rel="noopener noreferrer">Official Website ↗</a>}
        {app.sourceUrl && <a href={app.sourceUrl} target="_blank" rel="noopener noreferrer">Source Code ↗</a>}
      </div>
    </header>

    <section class="history-section" aria-labelledby="history-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Version archive</p>
          <h2 id="history-title">Stable Release History</h2>
        </div>
        <span class="release-count">{releases.length} {releases.length === 1 ? 'release' : 'releases'}</span>
      </div>

      {latestRelease && (
        <div class="latest-release">
          <span class="latest-label">Latest Stable Release</span>
          <strong>{latestRelease.version}</strong>
          <span class="latest-date">{formatDate(latestRelease.releaseDate)}</span>
          {latestRelease.releaseUrl && (
            <a href={latestRelease.releaseUrl} target="_blank" rel="noopener noreferrer">View Release ↗</a>
          )}
        </div>
      )}

      {releases.length > 0 ? (
        <ol class="release-list">
          {releases.map((release, index) => (
            <li class="release-item">
              <div class="release-marker" aria-hidden="true">{index + 1}</div>
              <div class="release-content">
                <div class="release-main">
                  <div>
                    <h3>{release.name || `${app.name} ${release.version}`}</h3>
                    <p class="release-version">Version {release.version}</p>
                  </div>
                  <time class="release-date" datetime={release.releaseDate || undefined}>
                    {formatDate(release.releaseDate)}
                  </time>
                </div>
                <div class="release-actions">
                  {release.releaseUrl && (
                    <a href={release.releaseUrl} target="_blank" rel="noopener noreferrer">Release Page ↗</a>
                  )}
                  {release.releaseNotes && (
                    <details class="release-notes">
                      <summary>Release Notes</summary>
                      <pre>{release.releaseNotes}</pre>
                    </details>
                  )}
                </div>
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <div class="empty-state">
          <h3>No stable release data available yet</h3>
          <p>Release information has not been collected for this application. Please check back after the next catalogue update.</p>
          {app.sourceUrl && <a href={app.sourceUrl} target="_blank" rel="noopener noreferrer">Visit the project source ↗</a>}
        </div>
      )}
    </section>

    <footer class="history-footer">
      <a href="/releases/">← Browse all Stable Releases</a>
    </footer>
  </main>
</Layout>

<style>
  .release-history {
    width: min(100% - 2rem, 900px);
    margin: 0 auto;
    padding: 2rem 0 5rem;
    color: var(--ink);
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 2rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  .breadcrumbs a,
  .back-link,
  .history-footer a {
    color: var(--accent);
    text-decoration: none;
  }

  .breadcrumbs a:hover,
  .back-link:hover,
  .history-footer a:hover,
  .app-links a:hover,
  .release-actions a:hover,
  .latest-release a:hover {
    text-decoration: underline;
  }

  .history-header {
    padding: 0 0 2rem;
    border-bottom: 1px solid var(--line);
  }

  .back-link {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-size: 0.85rem;
  }

  .app-title-row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .app-icon {
    display: grid;
    flex: 0 0 64px;
    width: 64px;
    height: 64px;
    place-items: center;
    overflow: hidden;
    color: var(--accent);
    background: var(--line);
    border-radius: 14px;
    font-family: var(--mono);
    font-size: 1.7rem;
    font-weight: 800;
  }

  .app-icon img {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0.45rem;
    object-fit: contain;
  }

  .eyebrow {
    margin: 0 0 0.35rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
  }

  .app-description {
    max-width: 700px;
    margin: 1.25rem 0 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .app-meta,
  .app-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    margin-top: 1rem;
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  .app-meta { color: var(--muted); }
  .app-links a,
  .release-actions a,
  .latest-release a {
    color: var(--accent);
    text-decoration: none;
  }

  .history-section { padding-top: 2.5rem; }

  .section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.5rem, 4vw, 2rem);
  }

  .release-count {
    padding: 0.35rem 0.6rem;
    color: var(--muted);
    background: var(--line);
    border-radius: 5px;
    font-family: var(--mono);
    font-size: 0.7rem;
  }

  .latest-release {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
    margin-bottom: 1.5rem;
    padding: 1rem 1.15rem;
    background: color-mix(in srgb, var(--accent) 7%, var(--bg));
    border: 1px solid color-mix(in srgb, var(--accent) 25%, var(--line));
    border-radius: 10px;
  }

  .latest-label {
    width: 100%;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.65rem;
    text-transform: uppercase;
  }

  .latest-release strong {
    color: var(--accent);
    font-family: var(--mono);
    font-size: 1.2rem;
  }

  .latest-date {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .latest-release a {
    margin-left: auto;
    font-size: 0.8rem;
  }

  .release-list {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .release-item {
    display: flex;
    gap: 1rem;
    padding: 1.1rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 10px;
  }

  .release-marker {
    display: grid;
    flex: 0 0 30px;
    width: 30px;
    height: 30px;
    place-items: center;
    color: var(--muted);
    background: var(--line);
    border-radius: 50%;
    font-family: var(--mono);
    font-size: 0.7rem;
  }

  .release-content { flex: 1; min-width: 0; }

  .release-main {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .release-main h3 {
    margin: 0;
    font-size: 1rem;
    overflow-wrap: anywhere;
  }

  .release-version {
    margin: 0.3rem 0 0;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  .release-date {
    color: var(--muted);
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .release-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 0.85rem;
    font-size: 0.78rem;
  }

  .release-notes { width: 100%; }
  .release-notes summary { color: var(--accent); cursor: pointer; }
  .release-notes pre {
    max-width: 100%;
    max-height: 420px;
    overflow: auto;
    margin: 0.75rem 0 0;
    padding: 1rem;
    color: var(--muted);
    background: var(--line);
    border-radius: 7px;
    font-family: var(--mono);
    font-size: 0.72rem;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .empty-state {
    padding: 2rem;
    text-align: center;
    background: var(--bg);
    border: 1px dashed var(--line);
    border-radius: 10px;
  }

  .empty-state h3 { margin: 0 0 0.5rem; }
  .empty-state p { color: var(--muted); line-height: 1.6; }
  .empty-state a { color: var(--accent); }

  .history-footer {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
  }

  @media (max-width: 560px) {
    .release-history { width: min(100% - 1.25rem, 900px); padding-top: 1.25rem; }
    .app-icon { flex-basis: 52px; width: 52px; height: 52px; }
    .release-item { gap: 0.7rem; padding: 0.85rem; }
    .release-date { white-space: normal; }
    .latest-release a { margin-left: 0; }
  }
</style>
